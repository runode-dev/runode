<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.runode.mobile.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>runode</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_runode._tcp</string>
	</array>
	<key>RunodeAPSEnvironment</key>
	<string>$(RUNODE_APS_ENVIRONMENT)</string>
	<key>RunodePushRelay</key>
	<string>$(RUNODE_PUSH_RELAY)</string>
</dict>
</plist>
