    "NSCameraUsageDescription" : {
      "comment" : "相机权限的说明，配对时扫码用。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan the pairing QR code shown by Runode on your Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扫电脑上 Runode 显示的配对二维码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "掃描電腦上 Runode 顯示的配對 QR 碼。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "面容 ID 权限的说明，远程桌面里解锁电脑时取出记住的登录密码用。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock your locked Mac with the login password you saved."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取出记住的电脑登录密码，替你解开锁着屏的电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取出記住的電腦登入密碼，替你解開鎖定的電腦。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "本地网络权限的说明。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find and connect to Runode on your Mac over the local network."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在局域网里找到并连接你电脑上的 Runode。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在區域網路中找到並連線到你電腦上的 Runode。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "麦克风权限的说明，终端页语音输入用。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dictation: hold the microphone key and speak, and the words are typed into the terminal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音输入：按住麦克风键说话，识别成文字打进终端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音輸入：按住麥克風鍵說話，辨識成文字打進終端機。"
